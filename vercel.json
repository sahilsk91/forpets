{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/css/(.*)", "dest": "frontend/css/$1" },
    { "src": "/js/(.*)", "dest": "frontend/js/$1" },
    { "src": "/images/(.*)", "dest": "frontend/images/$1" },
    { "src": "/product.json", "dest": "frontend/product.json" },
    { "src": "/", "dest": "frontend/index.html" },
    { "src": "/index.html", "dest": "frontend/index.html" },
    { "src": "/product.html", "dest": "frontend/product.html" },
    { "src": "/cart.html", "dest": "frontend/cart.html" },
    { "src": "/checkout.html", "dest": "frontend/checkout.html" },
    { "src": "/login.html", "dest": "frontend/login.html" },
    { "src": "/register.html", "dest": "frontend/register.html" },
    { "src": "/orderHistory.html", "dest": "frontend/orderHistory.html" },
    { "src": "/dashboard.html", "dest": "frontend/dashboard.html" }
  ]
}
